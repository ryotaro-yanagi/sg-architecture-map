{
  "name": "sg-architecture-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:publish": "node scripts/check-publish.mjs",
    "prototype:share-record": "node scripts/generate-share-record-prototypes.mjs",
    "test:collection": "node --test scripts/collection-state.test.ts scripts/architecture-record.test.ts",
    "test:coastline": "node --test scripts/share-record-coastline.test.mjs",
    "test:colors": "node --test scripts/colorTokens.test.ts",
    "test:location-character": "node --test scripts/location-character.test.ts",
    "test:publish-url": "node --test scripts/publication-url.test.mjs",
    "test:share-record": "node --test scripts/share-record.test.mjs",
    "test:weather": "node --test scripts/weather.test.ts",
    "test:cartography": "node --test scripts/cartography.test.ts",
    "test:mrt": "node --test scripts/mrtPilot.test.ts",
    "test:mrt-network": "node --test scripts/mrtNetwork.test.mjs",
    "test:credits": "node --test scripts/mapCredits.test.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "maplibre-gl": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
